{
  "name": "cifvis",
  "version": "0.9.7",
  "description": "Browser-native JavaScript library and web component for visualising crystal structures from CIF files.",

  "author": "Paul Niklas Ruth",
  "license": "MPL-2.0",
  "homepage": "https://niolon.github.io/cifvis/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Niolon/cifvis.git"
  },
  "bugs": {
    "url": "https://github.com/Niolon/cifvis/issues"
  },

  "keywords": [
    "crystallography",
    "cif",
    "crystal-structure",
    "x-ray-crystallography",
    "electron-density",
    "difference-density",
    "ortep",
    "anisotropic-displacement-parameters",
    "threejs",
    "webgl",
    "molecular-visualization"
  ],

  "type": "module",
  "main": "./dist/cifvis.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cifvis.js",
      "default": "./dist/cifvis.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./density": {
      "types": "./dist/density.d.ts",
      "import": "./dist/density.js",
      "default": "./dist/density.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js",
      "default": "./dist/experimental.js"
    },
    "./widget/register": {
      "types": "./dist/widget/register.d.ts",
      "import": "./dist/widget/register.js",
      "default": "./dist/widget/register.js"
    }
  },

  "files": [
    "dist",
    "src/lib/generated",
    "src",
    "LICENSE.md"
  ],

  "sideEffects": [
    "./dist/widget/register.js"
  ],

  "engines": {
    "node": ">=22"
  },

  "scripts": {
    "dev": "vite --config vite/vite.config.mjs serve ./site",

    "prebuild": "npm run generate:icons",
    "build": "vite build --config vite/vite.config.mjs && vite build --config vite/vite.umd.config.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "build:alldeps": "vite build --config vite/vite.alldeps.config.mjs",
    "build:site": "vite build --config vite/vite.site.config.mjs",
    "build:deployment": "node scripts/deploy.mjs --prepare-only",
    "clean:deployment": "node scripts/deploy.mjs --clean",

    "pretest": "npm run generate:icons",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "npm run build:types && tsc -p tsconfig.types-test.json",
    "pretest:browser": "npm run generate:icons && npm run build:alldeps",
    "test:browser": "node --test integration-tests/browser/contracts.test.mjs && node integration-tests/measurement-hover-playwright.mjs",
    "test:release": "npm run lint && npm test && npm run test:types && npm run docs:build && npm pack --dry-run",

    "lint": "eslint .",
    "lint:fix": "eslint . --fix",

    "generate:icons": "node scripts/generate-svg-icons.js",
    "generate:options": "node scripts/gen-options-reference.mjs",
    "tool:deformation-cif": "node scripts/create-deformation-density-cif.mjs",

    "docs": "jsdoc -c jsdoc.json",
    "docs:dev": "npm run generate:icons && npm run generate:options && vitepress dev docs",
    "docs:build": "npm run generate:icons && npm run generate:options && vitepress build docs",
    "docs:preview": "vitepress preview docs",

    "bench": "node benchmark/speed.mjs",

    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test && npm run test:types && npm run docs:build",

    "deploy": "node scripts/deploy.mjs"
  },

  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  },

  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.0.13",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdoc": "^4.0.5",
    "jsdom": "^29.1.1",
    "mathjs": "^15.2.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },

  "overrides": {
    "vitepress": {
      "@vitejs/plugin-vue": "^6.0.8",
      "vite": "^6.4.3"
    }
  }
}
