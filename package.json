{
  "name": "cifvis",
  "version": "0.9.5",
  "description": "",
  "main": "./src/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./src/core.js",
      "default": "./src/core.js"
    },
    "./density": {
      "types": "./dist/density.d.ts",
      "import": "./src/density.js",
      "default": "./src/density.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./src/experimental.js",
      "default": "./src/experimental.js"
    },
    "./widget/register": {
      "types": "./dist/widget/register.d.ts",
      "import": "./src/widget/register.js",
      "default": "./src/widget/register.js"
    }
  },
  "files": [
    "dist",
    "src/lib/generated",
    "src",
    "LICENSE.md"
  ],
  "scripts": {
    "generate-svg-icons": "node scripts/generate-svg-icons.js",
    "generate:deformation-cif": "node scripts/create-deformation-density-cif.mjs",
    "prebuild": "npm run generate-svg-icons",
    "dev": "vite --config vite/vite.config.mjs serve ./site",
    "build": "vite build --config vite/vite.config.mjs && npm run build:types",
    "build:types": "tsc -p tsconfig.types.json",
    "build:alldeps": "vite build --config vite/vite.alldeps.config.mjs",
    "build:site": "vite build --config vite/vite.site.config.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run generate-svg-icons",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "npm run build:types && tsc -p tsconfig.types-test.json",
    "pretest:browser": "npm run generate-svg-icons && npm run build:alldeps",
    "test:browser": "node --test integration-tests/browser/contracts.test.mjs && npm run test:browser-measurement-hover",
    "test:database-modifiers": "node --expose-gc --max-old-space-size=8192 integration-tests/test-structure-modifiers.mjs",
    "test:database-ortep": "node --expose-gc --max-old-space-size=8192 integration-tests/test-ortep.mjs",
    "test:database-ortep-chunked": "bash ./integration-tests/run-ortep-tests-chunked.sh",
    "test:browser-measurement-hover": "node integration-tests/measurement-hover-playwright.mjs",
    "test:database-collect-problem-cifs": "bash ./integration-tests/collect-problem-structures.sh",
    "report:cod-maintainer": "node integration-tests/generate-cod-report.mjs",
    "build:deployment": "node scripts/deploy.mjs --prepare-only",
    "clean:deployment": "node scripts/deploy.mjs --clean",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs": "jsdoc -c jsdoc.json",
    "gen:options": "node scripts/gen-options-reference.mjs",
    "docs:dev": "npm run generate-svg-icons && npm run gen:options && vitepress dev docs",
    "docs:build": "npm run generate-svg-icons && npm run gen:options && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench": "node benchmark/speed.mjs",
    "prebench:labels": "npm run build:alldeps",
    "bench:labels": "node benchmark/labels.mjs",
    "bench:density-symmetry": "node benchmark/difference-density-symmetry.mjs",
    "bench:contours": "node benchmark/contour-lines.mjs",
    "bench:surface-sampler": "node benchmark/surface-sampler.mjs",
    "bench:browser-density-consistency": "node benchmark/browser-node-fcalc-comparison.mjs",
    "bench:browser-density-consistency-analyze": "node benchmark/analyze-browser-density-consistency.mjs",
    "bench:browser-density-structure-impact": "node benchmark/browser-density-structure-impact.mjs",
    "bench:browser-density-structure-impact-analyze": "node benchmark/analyze-browser-density-structure-impact.mjs",
    "bench:bundle-startup": "node benchmark/bundle-startup.mjs"
  },
  "keywords": [],
  "author": "Paul Niklas Ruth",
  "license": "MPL-2.0",
  "dependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.185.1"
  },
  "overrides": {
    "vitepress": {
      "@vitejs/plugin-vue": "^6.0.8",
      "vite": "^6.4.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.0.13",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "jsdoc": "^4.0.5",
    "jsdom": "^29.1.1",
    "mathjs": "^15.2.0",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
