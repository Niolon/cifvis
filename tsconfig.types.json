{
  "compilerOptions": {
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "target": "ES2023"
  },
  "files": [
    "src/index.js",
    "src/core.js",
    "src/density.js",
    "src/experimental.js",
    "src/widget/register.js"
  ],
  "exclude": ["**/*.test.js"]
}
